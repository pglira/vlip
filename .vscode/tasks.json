{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build build -j",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build + install",
            "type": "shell",
            "command": "cmake --install build --prefix ~/.local",
            "dependsOn": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
